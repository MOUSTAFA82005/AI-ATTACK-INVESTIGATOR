# Copy this file to config/mail.env (config/ is never committed) and fill in the values.
# The server reads it when it starts, so you do not have to type them in every terminal.
AAI_SMTP_HOST=smtp.gmail.com
AAI_SMTP_PORT=587
AAI_SMTP_USER=your.sender@gmail.com
# Gmail "app password" (Google account > Security > App passwords), 16 letters, no spaces.
AAI_SMTP_PASSWORD=
